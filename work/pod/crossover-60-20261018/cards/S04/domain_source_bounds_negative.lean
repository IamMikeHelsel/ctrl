import Mathlib.Data.Real.Basic
import Mathlib.Tactic.Linarith
theorem deliberately_false_bound (w d q : ℝ)
    (h0 : (1 / 1 : ℝ) * (w) ≤ (2 / 1 : ℝ))
    (h1 : (-1 / 1 : ℝ) * (w) ≤ (2 / 1 : ℝ))
    (h2 : (1 / 1 : ℝ) * (d) ≤ (2 / 1 : ℝ))
    (h3 : (-1 / 1 : ℝ) * (d) ≤ (2 / 1 : ℝ))
    (h4 : (-1 / 1 : ℝ) * (d) ≤ (0 / 1 : ℝ))
    (h5 : (1 / 5 : ℝ) * (d) + (-1 / 1 : ℝ) * (q) ≤ (0 / 1 : ℝ))
    (h6 : (-3 / 10 : ℝ) * (d) + (1 / 1 : ℝ) * (q) ≤ (0 / 1 : ℝ))
    (h7 : (1 / 1 : ℝ) * (w) + (1 / 1 : ℝ) * (d) ≤ (11 / 10 : ℝ))
    (h8 : (-1 / 1 : ℝ) * (w) + (-1 / 1 : ℝ) * (d) ≤ (-9 / 10 : ℝ))
    (h9 : (1 / 1 : ℝ) * (w) + (1 / 1 : ℝ) * (d) ≤ (11 / 10 : ℝ))
    (h10 : (-1 / 1 : ℝ) * (w) + (-1 / 1 : ℝ) * (d) ≤ (-9 / 10 : ℝ))
    (h11 : (1 / 1 : ℝ) * (w) + (1 / 1 : ℝ) * (d) ≤ (11 / 10 : ℝ))
    (h12 : (-1 / 1 : ℝ) * (w) + (-1 / 1 : ℝ) * (d) ≤ (-9 / 10 : ℝ))
    (h13 : (1 / 1 : ℝ) * (w) + (1 / 1 : ℝ) * (q) ≤ (13 / 20 : ℝ))
    (h14 : (-1 / 1 : ℝ) * (w) + (-1 / 1 : ℝ) * (q) ≤ (-3 / 5 : ℝ)) : (1 : ℝ) ≤ (1 / 1 : ℝ) * (w) := by
  linarith only [h6, h7, h14]
