import Mathlib.Tactic
namespace V12Domain
theorem concrete_unique (b11 b12 b22 b13 b23 b33 : ℝ)
    (h0 : (1/1:ℝ)*b11 + (6/1:ℝ)*b12 + (0/1:ℝ)*b22 + (0/1:ℝ)*b13 + (0/1:ℝ)*b23 + (0/1:ℝ)*b33 = 0)
    (h1 : (15/4:ℝ)*b11 + (-3/1:ℝ)*b12 + (-9/1:ℝ)*b22 + (0/1:ℝ)*b13 + (0/1:ℝ)*b23 + (0/1:ℝ)*b33 = 0)
    (h2 : (11/5:ℝ)*b11 + (2/1:ℝ)*b12 + (0/1:ℝ)*b22 + (8/5:ℝ)*b13 + (0/1:ℝ)*b23 + (0/1:ℝ)*b33 = 0)
    (h3 : (279/100:ℝ)*b11 + (-11/5:ℝ)*b12 + (-1/1:ℝ)*b22 + (-44/25:ℝ)*b13 + (-8/5:ℝ)*b23 + (-16/25:ℝ)*b33 = 0)
    (h4 : (-1/13:ℝ)*b11 + (0/1:ℝ)*b12 + (36/13:ℝ)*b22 + (-6/13:ℝ)*b13 + (-36/13:ℝ)*b23 + (0/1:ℝ)*b33 = 0)
    (h5 : (-153/676:ℝ)*b11 + (-555/169:ℝ)*b12 + (-1377/169:ℝ)*b22 + (48/169:ℝ)*b13 + (-288/169:ℝ)*b23 + (144/169:ℝ)*b33 = 0)
    (hg : b11=1) : b11=(1/1:ℝ) ∧ b12=(-1/6:ℝ) ∧ b22=(17/36:ℝ) ∧ b13=(-7/6:ℝ) ∧ b23=(23/36:ℝ) ∧ b33=(209/36:ℝ) := by
  refine ⟨by simpa using hg, ?_, ?_, ?_, ?_, ?_⟩ <;> linarith
end V12Domain
