s_P = coefficients in <1,x,y,x^2,xy>: [0, 0, 1, -1, 1]
s_2P = coefficients in <1,x,y,x^2,xy>: [-d**3, -d**3 + 3*d**2, d**2 - d, -2*d, 1]
s_3P = coefficients in <1,x,y,x^2,xy>: [d**2, -d**2 - 2*d, d**2 - d, d + 1, 1]
s_4P = coefficients in <1,x,y,x^2,xy>: [-d, 1 - 2*d, 1, 2 - d, 1]

det M(d) = -(d**2 - 6*d - 1)*(d**2 - d - 1)**2
gcd of numerators of all 4x4 minors (rank<=3 locus): d**2 - d - 1
roots of det M (rank<=4 locus): (-1, [(d**2 - 6*d - 1, 1), (d**2 - d - 1, 2)])
