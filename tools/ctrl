import sys
from pathlib import Path

# Add tools directory to python path
tools_dir = Path(__file__).resolve().parent
if tools_dir.name != "tools":
    # In case of symlink
    tools_dir = Path(__file__).resolve().parent
sys.path.insert(0, str(tools_dir))

from ctrl_cli.cli import main

if __name__ == "__main__":
    main()
