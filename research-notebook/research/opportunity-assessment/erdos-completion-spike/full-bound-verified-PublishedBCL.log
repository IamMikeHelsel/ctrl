'Erdos128.CompletionBridge.bclCutCertificate_all_of_eventually' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'Erdos128.CompletionBridge.fractional_2587_100000_all_orders' depends on axioms: [propext, Classical.choice, Quot.sound]
'Erdos128.CompletionBridge.sparse_half_2587_100000' depends on axioms: [propext, Classical.choice, Quot.sound]
def Erdos128.CompletionBridge.BCLEventual.{u} : Prop :=
∃ N,
  ∀ (W : Type u) [inst : Fintype W] [inst_1 : DecidableEq W] (H : SimpleGraph W) [inst_2 : DecidableRel H.Adj],
    N ≤ Fintype.card W → H.CliqueFree 3 → Erdos128.BCLCutCertificate H
@Erdos128.CompletionBridge.sparse_half_2587_100000 : ∀ {V : Type u_1} [inst : Fintype V] [inst_1 : DecidableEq V],
  (∃ N,
      ∀ (W : Type u_1) [inst : Fintype W] [inst_2 : DecidableEq W] (H : SimpleGraph W) [inst_3 : DecidableRel H.Adj],
        N ≤ Fintype.card W → H.CliqueFree 3 → Erdos128.BCLCutCertificate H) →
    ∀ (G : SimpleGraph V) [inst_2 : DecidableRel G.Adj],
      G.CliqueFree 3 →
        ∃ S, S.card = Fintype.card V / 2 ∧ ↑(Erdos128.edgeCountOn G S) ≤ 2587 / 100000 * ↑(Fintype.card V) ^ 2
