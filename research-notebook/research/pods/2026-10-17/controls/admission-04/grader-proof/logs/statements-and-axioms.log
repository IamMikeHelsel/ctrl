structure CausalAdmission.IsAdmissible (a0 J S T : ℝ) (a j s : ℝ → ℝ) : Prop
number of parameters: 7
fields:
  CausalAdmission.IsAdmissible.acceleration_continuous : ContinuousOn a (Set.Icc 0 T)
  CausalAdmission.IsAdmissible.acceleration_initial : a 0 = a0
  CausalAdmission.IsAdmissible.acceleration_derivative : ∀ t ∈ Set.Ioo 0 T, HasDerivAt a (j t) t
  CausalAdmission.IsAdmissible.jerk_continuous : ContinuousOn j (Set.Icc 0 T)
  CausalAdmission.IsAdmissible.jerk_initial : j 0 = J
  CausalAdmission.IsAdmissible.jerk_bound : ∀ t ∈ Set.Icc 0 T, |j t| ≤ J
  CausalAdmission.IsAdmissible.snap_derivative : ∀ t ∈ Set.Ico 0 T, HasDerivWithinAt j (s t) (Set.Ici t) t
  CausalAdmission.IsAdmissible.snap_bound : ∀ t ∈ Set.Ico 0 T, |s t| ≤ S
constructor:
  CausalAdmission.IsAdmissible.mk {a0 J S T : ℝ} {a j s : ℝ → ℝ}
    (acceleration_continuous : ContinuousOn a (Set.Icc 0 T)) (acceleration_initial : a 0 = a0)
    (acceleration_derivative : ∀ t ∈ Set.Ioo 0 T, HasDerivAt a (j t) t) (jerk_continuous : ContinuousOn j (Set.Icc 0 T))
    (jerk_initial : j 0 = J) (jerk_bound : ∀ t ∈ Set.Icc 0 T, |j t| ≤ J)
    (snap_derivative : ∀ t ∈ Set.Ico 0 T, HasDerivWithinAt j (s t) (Set.Ici t) t)
