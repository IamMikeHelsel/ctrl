      ∀ t ∈ Set.Icc 0 H,
        |read b t 0 - f (stamp b t) 0| ≤ 1 / 1000 ∧
          |read b t 1 - f (stamp b t) 1| ≤ 1 / 100 ∧ |read b t 2 - f (stamp b t) 2| ≤ 1 / 20
  LeanControls.DigitalHold.Execution.rate : ∀ (b : Bool), ∀ t ∈ Set.Icc 0 H, 8 ≤ r b t ∧ r b t ≤ 12
  LeanControls.DigitalHold.Execution.target_error : ∀ (b : Bool), ∀ t ∈ Set.Icc 0 H, |d b t| ≤ 1 / 100
  LeanControls.DigitalHold.Execution.right_ode : ∀ t ∈ Set.Ico 0 H,
      ∀ (i : Fin 3),
        HasDerivWithinAt (fun s => f s i)
          (LeanControls.DigitalHold.rhs (r true t)
            (LeanControls.DigitalHold.clip (LeanControls.DigitalHold.command c (read true t))) (d true t) (f t) i)
          (Set.Ici t) t
  LeanControls.DigitalHold.Execution.left_ode : ∀ t ∈ Set.Ioc 0 H,
      ∀ (i : Fin 3),
        HasDerivWithinAt (fun s => f s i)
          (LeanControls.DigitalHold.rhs (r false t)
            (LeanControls.DigitalHold.clip (LeanControls.DigitalHold.command c (read false t))) (d false t) (f t) i)
          (Set.Iic t) t
