theorem LeanControls.DigitalHold.digital_invariant : ∀ {H c : ℝ},
  0 ≤ H →
    ∀ {f : ℝ → LeanControls.DigitalHold.State} {r d stamp : Bool → ℝ → ℝ}
      {read : Bool → ℝ → LeanControls.DigitalHold.State},
      LeanControls.DigitalHold.Execution H c f r d stamp read →
        (∀ (i : Fin 3), |LeanControls.DigitalHold.coordinates c (f 0) i| ≤ LeanControls.DigitalHold.radius) →
          ∀ t ∈ Set.Icc 0 H,
            ∀ (i : Fin 3), |LeanControls.DigitalHold.coordinates c (f t) i| ≤ LeanControls.DigitalHold.radius :=
fun {H c} hH {f} {r d stamp} {read} ex hi =>
  let z := fun t => LeanControls.DigitalHold.coordinates c (f t);
  have hradius :=
    of_eq_true
      (Eq.trans
        (congrArg (LE.le 0)
          (Mathlib.Meta.NormNum.IsNNRat.to_eq
