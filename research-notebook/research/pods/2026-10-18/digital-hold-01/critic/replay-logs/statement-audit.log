theorem LeanControls.DigitalHold.sampled_hold : ∀ {H c : ℝ},
  0 ≤ H →
    ∀ {f : ℝ → LeanControls.DigitalHold.State} {r d stamp : Bool → ℝ → ℝ}
      {read : Bool → ℝ → LeanControls.DigitalHold.State} {q : LeanControls.DigitalHold.Schedule},
      LeanControls.DigitalHold.IsSampledExecution H c f r d stamp read q →
        (∀ (i : Fin 3), |LeanControls.DigitalHold.coordinates c (f 0) i| ≤ LeanControls.DigitalHold.radius) →
          (∀ (b : Bool), stamp b 0 = 0 ∧ read b 0 = q.measurement 0) ∧
            (∀ t ∈ Set.Icc 0 H,
                ∀ (i : Fin 3), |LeanControls.DigitalHold.coordinates c (f t) i| ≤ LeanControls.DigitalHold.radius) ∧
              ∀ t ∈ Set.Icc 0 H,
                |f t 0 - c| ≤ LeanControls.DigitalHold.radius ∧
                  |f t 1| ≤ 8 * LeanControls.DigitalHold.radius ∧
                    |f t 2| ≤ 64 * LeanControls.DigitalHold.radius ∧
                      ∀ (b : Bool),
                        |LeanControls.DigitalHold.command c (read b t)| ≤ 891 / 625 ∧
                          LeanControls.DigitalHold.clip (LeanControls.DigitalHold.command c (read b t)) =
                              LeanControls.DigitalHold.command c (read b t) ∧
                            |LeanControls.DigitalHold.clip (LeanControls.DigitalHold.command c (read b t)) + d b t| ≤
                              3589 / 2500 :=
