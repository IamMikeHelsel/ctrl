                LeanControls.VariableResponse.IsTrajectory T rLoss qLoss f →
                  ContinuousOn rLoss (Set.Icc 0 T) →
                    (∀ t ∈ Set.Icc 0 T, 0 ≤ rLoss t) →
                      (∀ t ∈ Set.Icc 0 T, qLoss t ≤ A) →
                        f 0 0 ≤ X →
                          0 ≤ f 0 1 →
                            f 0 1 ≤ v0 →
                              f 0 2 ≤ A →
