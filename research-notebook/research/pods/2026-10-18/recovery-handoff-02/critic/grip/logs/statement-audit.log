                                    f (T + s)) →
                                  ContinuousOn rBrake (Set.Icc 0 (LeanControls.Recovery.recoveryHorizon v0 A T b k)) →
                                    (∀ s ∈ Set.Icc 0 (LeanControls.Recovery.recoveryHorizon v0 A T b k), k ≤ rBrake s) →
                                      (∀ s ∈ Set.Icc 0 (LeanControls.Recovery.recoveryHorizon v0 A T b k),
                                          qBrake s ≤ -b) →
                                        ∃ τ ∈ Set.Icc 0 (T + LeanControls.Recovery.recoveryHorizon v0 A T b k),
