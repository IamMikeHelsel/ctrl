theorem LeanControls.BrakingDelayedHold.observation_admission : ∀ {H D : ℝ},
  0 ≤ D →
    D ≤ H →
      ∀ {f : ℝ → LeanControls.DigitalHold.State} {r d stamp : Bool → ℝ → ℝ}
        {read : Bool → ℝ → LeanControls.DigitalHold.State} {q : LeanControls.DigitalHold.Schedule},
        LeanControls.BrakingDelayedHold.Execution H D f r d stamp read →
          LeanControls.BrakingDelayedHold.IsSchedule H D q stamp read →
            q.measurement 0 = LeanControls.BrakingDelayedHold.exampleReading →
              LeanControls.BrakingDelayedHold.Admitted f :=
fun {H D} hD hDH {f} {r d stamp} {read} {q} ex hs hm =>
  have ht := ⟨le_rfl, LE.le.trans hD hDH⟩;
  have hts := hs.timestamp true 0 ht;
  have hread := hs.held_reading true 0 ht;
  have he := ex.error true 0 ht;
  id
    (Eq.mpr
      (id
        (congr (congrArg And (congrFun' (congrArg LE.le (abs_sub_comm (f 0 0) (7 / 50))) (1 / 1000)))
          (congr (congrArg And (congrFun' (congrArg LE.le (abs_sub_comm (f 0 1) (-1 / 100))) (1 / 100)))
            (congrFun' (congrArg LE.le (abs_sub_comm (f 0 2) (-117 / 100))) (1 / 20)))))
      (Eq.mp
        (congrArg (fun _a => |_a 0 - f 0 0| ≤ 1 / 1000 ∧ |_a 1 - f 0 1| ≤ 1 / 100 ∧ |_a 2 - f 0 2| ≤ 1 / 20)
          (Eq.mp (congrArg (fun _a => read true 0 = _a) hm)
            (Eq.mp (congrArg (fun _a => read true 0 = q.measurement _a) (hs.startup_index true 0 ⟨le_rfl, hD⟩)) hread)))
        (Eq.mp
          (congrArg
            (fun _a =>
              |read true 0 0 - f _a 0| ≤ 1 / 1000 ∧
                |read true 0 1 - f _a 1| ≤ 1 / 100 ∧ |read true 0 2 - f _a 2| ≤ 1 / 20)
            (Eq.mp (congrArg (fun _a => stamp true 0 = _a) hs.first_sample)
              (Eq.mp (congrArg (fun _a => stamp true 0 = q.sample _a) (hs.startup_index true 0 ⟨le_rfl, hD⟩)) hts)))
          he)))
theorem LeanControls.BrakingDelayedHold.delayed_sampled_hold : ∀ {H D : ℝ},
  0 ≤ D →
    D ≤ H →
      D ≤ LeanControls.BrakingDelayedHold.startupLimit →
        ∀ {f : ℝ → LeanControls.DigitalHold.State} {r d stamp : Bool → ℝ → ℝ}
          {read : Bool → ℝ → LeanControls.DigitalHold.State} {q : LeanControls.DigitalHold.Schedule},
          LeanControls.BrakingDelayedHold.Execution H D f r d stamp read →
            LeanControls.BrakingDelayedHold.IsSchedule H D q stamp read →
              q.measurement 0 = LeanControls.BrakingDelayedHold.exampleReading →
                (∀ (b : Bool), stamp b D = 0 ∧ read b D = LeanControls.BrakingDelayedHold.exampleReading) ∧
                  (∀ t ∈ Set.Icc 0 H,
                      ∀ (i : Fin 3),
                        |LeanControls.DigitalHold.coordinates LeanControls.BrakingDelayedHold.center (f t) i| ≤
                          LeanControls.DigitalHold.radius) ∧
                    ∀ t ∈ Set.Icc 0 H,
                      163 / 5000 ≤ f t 0 ∧
                        f t 0 ≤ 2873 / 20000 ∧
                          |f t 1| ≤ 8 * LeanControls.DigitalHold.radius ∧
                            |f t 2| ≤ 64 * LeanControls.DigitalHold.radius ∧
                              ∀ (b : Bool),
                                |LeanControls.BrakingDelayedHold.actualCommand D LeanControls.BrakingDelayedHold.center
                                        read b t +
                                      d b t| ≤
                                  3589 / 2500 :=
