def Erdos128.HasNormalizedFractionalHalfBoundQ.{u} : {V : Type u} →
  [Fintype.{u} V] → (G : SimpleGraph.{u} V) → [DecidableRel.{u + 1, u + 1} (SimpleGraph.Adj.{u} G)] → ℚ → Prop :=
fun {V} [Fintype.{u} V] G [DecidableRel.{u + 1, u + 1} (SimpleGraph.Adj.{u} G)] B =>
  ∃ x, Erdos128.IsFractionalHalf.{u} x ∧ LE.le.{0} (Erdos128.normalizedEdgeCostQ.{u} G x) B
def Erdos128.FiniteProfileBridge.sideMass.{u} : {V : Type u} →
  [inst : Fintype.{u} V] →
    [inst_1 : DecidableEq.{u + 1} V] →
      {G : SimpleGraph.{u} V} →
        [inst_2 : DecidableRel.{u + 1, u + 1} (SimpleGraph.Adj.{u} G)] → Erdos128.OrientedBCLCut.{u} G → ℚ :=
fun {V} [Fintype.{u} V] [DecidableEq.{u + 1} V] {G} [DecidableRel.{u + 1, u + 1} (SimpleGraph.Adj.{u} G)] C =>
  HDiv.hDiv.{0, 0, 0} ↑(Finset.card.{u} (Erdos128.OrientedBCLCut.large.{u} C)) ↑(Fintype.card.{u} V)
def Erdos128.FiniteProfileBridge.sideEdges.{u} : {V : Type u} →
  [inst : Fintype.{u} V] →
    [inst_1 : DecidableEq.{u + 1} V] →
      {G : SimpleGraph.{u} V} →
        [inst_2 : DecidableRel.{u + 1, u + 1} (SimpleGraph.Adj.{u} G)] → Erdos128.OrientedBCLCut.{u} G → ℚ :=
fun {V} [Fintype.{u} V] [DecidableEq.{u + 1} V] {G} [DecidableRel.{u + 1, u + 1} (SimpleGraph.Adj.{u} G)] C =>
  HDiv.hDiv.{0, 0, 0} (↑(Erdos128.edgeCountOn.{u} G (Erdos128.OrientedBCLCut.large.{u} C)))
    (HPow.hPow.{0, 0, 0} (↑(Fintype.card.{u} V)) 2)
def Erdos128.FiniteProfileBridge.lowCertificate : ℚ → ℚ → ℚ → ℚ → ℚ :=
fun y j R L =>
  HAdd.hAdd.{0, 0, 0} (Erdos128.FiniteProfileBridge.lowCenter y j R)
    (HDiv.hDiv.{0, 0, 0} (HPow.hPow.{0, 0, 0} (HSub.hSub.{0, 0, 0} L (Erdos128.FiniteProfileBridge.baseSlope y j R)) 2)
      (HMul.hMul.{0, 0, 0} 4 (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 4 R) 1)))
def Erdos128.FiniteProfileBridge.highCertificate : ℚ → ℚ → ℚ → ℚ → ℚ :=
fun y j R L =>
  HAdd.hAdd.{0, 0, 0}
    (HDiv.hDiv.{0, 0, 0}
      (HPow.hPow.{0, 0, 0}
        (HSub.hSub.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} (HSub.hSub.{0, 0, 0} j R) (HSub.hSub.{0, 0, 0} y (1 / 2))) L) 2)
      4)
    (HMul.hMul.{0, 0, 0} L (Erdos128.FiniteProfileBridge.meanDegree y j))
