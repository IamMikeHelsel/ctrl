module
public import ConstructiveFlow
@[expose] public section
noncomputable section
set_option autoImplicit false
namespace LeanControls.ConstructiveHold
open Set Filter DigitalHold

abbrev pendingSide (b : Bool) (t : ℝ) : Prop := if b then t<h else t<h

theorem pending_le {b : Bool} {t : ℝ} (hs : pendingSide b t) : t≤h := by
  cases b
  · exact hs
  · exact hs.le

def field (p : Bool → ℝ → ℝ) (R : ℕ → ℝ) (b : Bool) (t : ℝ) : ℝ :=
  if pendingSide b t then p b t else R (index b t+1)

theorem measure_step (m : State) (g : ℝ → State) (R δ : ℕ → ℝ) (ε : ℕ → State)
    (n j : ℕ) (hj : grid j ≤ grid (n+1)) :
    measure m ε (state m g R δ ε (n+1)) j=measure m ε (state m g R δ ε n) j := by
  simp only [measure]
  split_ifs
  · rfl
  · rw [state_step_before m g R δ ε n hj]

theorem readings_step (m : State) (g : ℝ → State) (R δ : ℕ → ℝ) (ε : ℕ → State)
    (n : ℕ) (b : Bool) {t : ℝ} (ht : t ∈ Icc 0 (grid (n+1))) :
    readings m ε (state m g R δ ε (n+1)) b t=readings m ε (state m g R δ ε n) b t := by
  apply measure_step
  have hh := (DelayedEntry.Witness.stamp_age ht.1 b).2.1
  exact hh.trans ht.2

theorem command_step (m : State) (g : ℝ → State) (R δ : ℕ → ℝ) (ε : ℕ → State)
    (n : ℕ) (b : Bool) {t : ℝ} (ht : t ∈ Icc 0 (grid (n+1))) :
    ClearanceAdmission.actualCommand h (ClearanceAdmission.center m)
      (readings m ε (state m g R δ ε (n+1))) b t=
    ClearanceAdmission.actualCommand h (ClearanceAdmission.center m)
      (readings m ε (state m g R δ ε n)) b t := by
  unfold ClearanceAdmission.actualCommand
  rw [readings_step m g R δ ε n b ht]

theorem new_right_fields (m : State) (g : ℝ → State) (R δ : ℕ → ℝ) (ε : ℕ → State)
    (p : Bool → ℝ → ℝ) {n : ℕ} {t : ℝ} (ht : t ∈ Ico (grid (n+1)) (grid (n+2))) :
    field p R true t=R (n+1) ∧
    ClearanceAdmission.actualCommand h (ClearanceAdmission.center m)
      (readings m ε (state m g R δ ε (n+1))) true t=cellCommand m ε (state m g R δ ε n) n := by
  have hi := right_index ht
  have hht : h ≤ t := by rw [grid_succ] at ht; linarith [ht.1,grid_nonneg n]
  have hm := measure_step m g R δ ε n n (grid_strict.monotone (by omega))
  constructor
  · simp only [field,pendingSide,ite_true,not_lt_of_ge hht,ite_false,hi]
  · simp only [ClearanceAdmission.actualCommand,ite_true,not_lt_of_ge hht,ite_false,
      readings,hi,hm,cellCommand]

theorem new_left_fields (m : State) (g : ℝ → State) (R δ : ℕ → ℝ) (ε : ℕ → State)
    (p : Bool → ℝ → ℝ) {n : ℕ} {t : ℝ} (ht : t ∈ Ioc (grid (n+1)) (grid (n+2))) :
    field p R false t=R (n+1) ∧
    ClearanceAdmission.actualCommand h (ClearanceAdmission.center m)
      (readings m ε (state m g R δ ε (n+1))) false t=cellCommand m ε (state m g R δ ε n) n := by
  have hi := left_index ht
  have hht : h < t := by rw [grid_succ] at ht; linarith [ht.1,grid_nonneg n]
  have hm := measure_step m g R δ ε n n (grid_strict.monotone (by omega))
  constructor
  · simp only [field,pendingSide,Bool.false_eq_true,ite_false,not_le_of_gt hht,hi]
  · simp only [ClearanceAdmission.actualCommand,Bool.false_eq_true,ite_false,not_le_of_gt hht,
      readings,hi,hm,cellCommand]

section Construction
variable {m : State} {g : ℝ → State} {rp dp : Bool → ℝ → ℝ} {R δ : ℕ → ℝ} {ε : ℕ → State}
variable (pre : ClearanceAdmission.Execution h h m g rp dp (fun _ _ => 0) (fun _ _ => m))
  (hr : ∀ n, 1 ≤ n → 8 ≤ R n ∧ R n ≤ 12)
  (hd : ∀ n, 1 ≤ n → |δ n| ≤ 1/100)
  (he : ∀ n, |ε n 0| ≤ 1/1000 ∧ |ε n 1| ≤ 1/100 ∧ |ε n 2| ≤ 1/20)
include pre hr hd he

theorem make_execution {H : ℝ} {f : ℝ → State} (hf0 : f 0=g 0)
    (hc : ContinuousOn f (Icc 0 H))
    (hR : ∀ t ∈ Ico 0 H, ∀ i, HasDerivWithinAt (fun s => f s i)
      (rhs (field rp R true t) (ClearanceAdmission.actualCommand h (ClearanceAdmission.center m)
        (readings m ε f) true t) (field dp δ true t) (f t) i) (Ici t) t)
    (hL : ∀ t ∈ Ioc 0 H, ∀ i, HasDerivWithinAt (fun s => f s i)
      (rhs (field rp R false t) (ClearanceAdmission.actualCommand h (ClearanceAdmission.center m)
        (readings m ε f) false t) (field dp δ false t) (f t) i) (Iic t) t) :
    ClearanceAdmission.Execution H h m f (field rp R) (field dp δ) stamp (readings m ε f) := by
  refine ⟨hc,?_,?_,?_,?_,hR,hL⟩
  · intro b t ht; exact DelayedEntry.Witness.stamp_age ht.1 b
  · intro b t ht
    by_cases hz : index b t=0
    · have hh := pre.error true 0 ⟨le_rfl,by norm_num⟩
      simpa [readings,measure,stamp,DelayedEntry.Witness.stamp,hz,hf0] using hh
    · simpa [readings,measure,stamp,DelayedEntry.Witness.stamp,grid,hz] using he (index b t)
  · intro b t ht
    by_cases hs : pendingSide b t
    · rw [field,if_pos hs]
      exact pre.rate b t ⟨ht.1,pending_le hs⟩
    · rw [field,if_neg hs]; exact hr _ (by omega)
  · intro b t ht
    by_cases hs : pendingSide b t
    · rw [field,if_pos hs]
      exact pre.target_error b t ⟨ht.1,pending_le hs⟩
    · rw [field,if_neg hs]; exact hd _ (by omega)

/-- Finite continuation is generated by recursion. The proof uses only the
one-sided pending prefix, exact exponential phases, and the original noise box. -/
theorem state_execution (n : ℕ) :
    ClearanceAdmission.Execution (grid (n+1)) h m (state m g R δ ε n)
      (field rp R) (field dp δ) stamp (readings m ε (state m g R δ ε n)) := by
  induction n with
  | zero =>
    apply make_execution pre hr hd he rfl
    · simpa [state,grid] using pre.continuous
    · intro t ht i
      have htt : t<h := by simpa [grid] using ht.2
      have h0 := pre.right_ode t ⟨ht.1,htt⟩ i
      simpa only [state,field,pendingSide,ClearanceAdmission.actualCommand,Bool.false_eq_true,ite_false,ite_true,htt] using h0
    · intro t ht i
      have htt : t≤h := by simpa [grid] using ht.2
      have h0 := pre.left_ode t ⟨ht.1,htt⟩ i
      simpa only [state,field,pendingSide,ClearanceAdmission.actualCommand,Bool.false_eq_true,ite_false,ite_true,htt] using h0
  | succ n ih =>
    have hR : R (n+1)≠0 := by have hh := (hr (n+1) (by omega)).1; linarith
    have hj := (phase_initial m R δ ε (state m g R δ ε n) n).symm
    apply make_execution pre hr hd he (state_prefix m g R δ ε (n+1) (by norm_num))
    · exact paste_continuous ih.continuous (phase_continuous m δ ε _ n hR) hj
    · intro t ht i
      by_cases hb : t<grid (n+1)
      · have htold : t ∈ Icc 0 (grid (n+1)) := ⟨ht.1,hb.le⟩
        rw [command_step m g R δ ε n true htold,state_step_before m g R δ ε n hb.le]
        exact paste_right_old hb (ih.right_ode t ⟨ht.1,hb⟩ i)
      · have hcell : t ∈ Ico (grid (n+1)) (grid (n+2)) := ⟨le_of_not_gt hb,by simpa [Nat.add_assoc] using ht.2⟩
        have hf := new_right_fields m g R δ ε rp hcell
        have hdv := (new_right_fields m g δ δ ε dp hcell).1
        rw [hf.1,hf.2,hdv]
        have hs : state m g R δ ε (n+1) t=phase m R δ ε (state m g R δ ε n) n t :=
          paste_after hj hcell.1
        rw [hs]
        exact paste_right_new hcell.1 hj (phase_ode m δ ε _ n hR t i)
    · intro t ht i
      by_cases hb : t≤grid (n+1)
      · have htold : t ∈ Icc 0 (grid (n+1)) := ⟨ht.1.le,hb⟩
        rw [command_step m g R δ ε n false htold,state_step_before m g R δ ε n hb]
        exact paste_left_old hb (ih.left_ode t ⟨ht.1,hb⟩ i)
      · have hcell : t ∈ Ioc (grid (n+1)) (grid (n+2)) := ⟨lt_of_not_ge hb,by simpa [Nat.add_assoc] using ht.2⟩
        have hf := new_left_fields m g R δ ε rp hcell
        have hdv := (new_left_fields m g δ δ ε dp hcell).1
        rw [hf.1,hf.2,hdv]
        have hs : state m g R δ ε (n+1) t=phase m R δ ε (state m g R δ ε n) n t :=
          paste_after hj hcell.1.le
        rw [hs]
        exact paste_left_new hcell.1 (phase_ode m δ ε _ n hR t i)

/-- The unchanged C5 ceiling is applied only after construction of an actual
execution. This does not construct the detector's earlier braking history. -/
theorem finite_clearance (n : ℕ) (hg : ClearanceAdmission.Guard m) :
    (∀ t ∈ Icc 0 h, state m g R δ ε n t=g t) ∧
    ClearanceAdmission.Execution (grid (n+1)) h m (state m g R δ ε n)
      (field rp R) (field dp δ) stamp (readings m ε (state m g R δ ε n)) ∧
    ClearanceAdmission.IsSchedule (grid (n+1)) h (schedule m ε (state m g R δ ε n))
      stamp (readings m ε (state m g R δ ε n)) ∧
    (schedule m ε (state m g R δ ε n)).measurement 0=m ∧
    ∀ t ∈ Icc 0 (grid (n+1)), state m g R δ ε n t 0 ≤ 3/20-1277551/20100000000 := by
  have hx := state_execution pre hr hd he n
  have hq := actual_schedule (grid (n+1)) m ε (state m g R δ ε n)
  have hm : (schedule m ε (state m g R δ ε n)).measurement 0=m := by simp [schedule,measure]
  have hH : h ≤ grid (n+1) := by rw [grid_succ]; linarith [grid_nonneg n]
  have hh := ClearanceEntry.sampled_clearance (by norm_num : (0:ℝ)≤h) hH
    (by norm_num [ClearanceAdmission.startupLimit]) hx hq hm hg
  exact ⟨fun t ht => state_prefix m g R δ ε n ht.2,hx,hq,hm,fun t ht => (hh.2.2.1 t ht).2⟩

theorem continuation (N : ℕ) (hN : 2 ≤ N) (hg : ClearanceAdmission.Guard m) :
    (∀ t ∈ Icc 0 h, state m g R δ ε (N-1) t=g t) ∧
    ClearanceAdmission.Execution (grid N) h m (state m g R δ ε (N-1))
      (field rp R) (field dp δ) stamp (readings m ε (state m g R δ ε (N-1))) ∧
    ClearanceAdmission.IsSchedule (grid N) h (schedule m ε (state m g R δ ε (N-1)))
      stamp (readings m ε (state m g R δ ε (N-1))) ∧
    (schedule m ε (state m g R δ ε (N-1))).measurement 0=m ∧
    ∀ t ∈ Icc 0 (grid N), state m g R δ ε (N-1) t 0 ≤ 3/20-1277551/20100000000 := by
  simpa only [Nat.sub_add_cancel (show 1≤N by omega)] using finite_clearance pre hr hd he (N-1) hg

end Construction
end LeanControls.ConstructiveHold
