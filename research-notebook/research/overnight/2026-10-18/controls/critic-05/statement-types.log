ControlsReview05.literal_physical_contract {H : ℝ} (hH : LE.le.{0} (171 / 50) H) {r w : ℝ → ℝ}
  {f : ℝ → LeanControls.UncertainLag.State}
  (hf :
    LeanControls.VariableResponse.IsTrajectory H r
      (fun t =>
        HAdd.hAdd.{0, 0, 0}
          (HAdd.hAdd.{0, 0, 0}
            (HSub.hSub.{0, 0, 0}
              (HSub.hSub.{0, 0, 0}
                (HSub.hSub.{0, 0, 0}
                  (RobotMotion.acceleration (1 / 5)
                    (RobotMotion.realEvents RobotMotion.AccelerationAdmission.deferredReturn) t)
                  (HMul.hMul.{0, 0, 0} 800
                    (HSub.hSub.{0, 0, 0} (f t 0)
                      (RobotMotion.position 0 (1 / 5)
                        (RobotMotion.realEvents RobotMotion.AccelerationAdmission.deferredReturn) t))))
                (HMul.hMul.{0, 0, 0} 60
                  (HSub.hSub.{0, 0, 0} (f t 1)
                    (RobotMotion.velocity (1 / 5)
                      (RobotMotion.realEvents RobotMotion.AccelerationAdmission.deferredReturn) t))))
              (HDiv.hDiv.{0, 0, 0}
                (HSub.hSub.{0, 0, 0} (f t 2)
                  (RobotMotion.acceleration (1 / 5)
                    (RobotMotion.realEvents RobotMotion.AccelerationAdmission.deferredReturn) t))
                2))
            (HDiv.hDiv.{0, 0, 0}
              (RobotMotion.jerk (1 / 5) (RobotMotion.realEvents RobotMotion.AccelerationAdmission.deferredReturn) t)
              96))
          (w t))
      f)
  (hrlo : ∀ (t : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} 0 H) t → LE.le.{0} 80 (r t))
  (hrhi : ∀ (t : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} 0 H) t → LE.le.{0} (r t) 120)
  (hw : ∀ (t : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} 0 H) t → LE.le.{0} (abs.{0} (w t)) (1 / 100))
  (hi :
    ∀ (i : Fin 3),
      LE.le.{0}
        (abs.{0}
          (LeanControls.RobustHold.coordinates 0
            (LeanControls.ScaledTracking.scaledError 10 f
