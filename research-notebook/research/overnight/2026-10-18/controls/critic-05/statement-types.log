        HAdd.hAdd.{0, 0, 0}
          (LeanControls.Settling.holdInput 10 0
            (fun u => RobotMotion.FIRHoldWitness.biasedReference (1 / 200) (HAdd.hAdd.{0, 0, 0} (71 / 50) u)) s)
          (RobotMotion.FIRHoldWitness.changingDisturbance s))
      fun s => RobotMotion.FIRHoldWitness.biasedReference (1 / 200) (HAdd.hAdd.{0, 0, 0} (71 / 50) s)
