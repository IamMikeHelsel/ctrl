def boxes : Fin 4 → ℕ → Box := ![boxes0,boxes1,boxes2,boxes3]
theorem checked_steps : ∀ c : Fin 4, ∀ n<25,
    BoxSubset (sampledBox coeff (boxes c n) (point 0) (point 0)) (boxes c (n+1)) := by
  intro c
  fin_cases c <;> intro n hn <;> interval_cases n <;> intro i <;> fin_cases i <;>
    decide +kernel

theorem endpoints (c : Fin 4) {r : ℝ} {z : UncertainLag.State}
    (hk : CoeffMem coeff r (1/20)) (hz : BoxMem (boxes c 0) z) :
    ∀ n≤25, BoxMem (boxes c n) (stateTrace (fun _=>r) (fun _=>1/20)
      (fun _=>0) (fun _=>0) z n) := by
  exact certificate_trace_sound _ _ _ _ (fun _=>coeff) (fun _=>point 0) (fun _=>point 0)
    (boxes c) hz (fun _ _=>hk) (fun _ _=>by simpa using point_mem 0)
    (fun _ _=>by simpa using point_mem 0) (checked_steps c)
end LeanControls.PerformanceProbe.BatchFour
